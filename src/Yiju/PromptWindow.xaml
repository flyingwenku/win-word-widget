<Window x:Class="Yiju.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一句"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF6F5F4"
        ShowInTaskbar="False">
    <!-- 一个够用的输入弹窗：编辑句子用两个框，建列表只用一个框 -->
    <StackPanel Margin="14">
        <TextBlock x:Name="LbA" FontSize="12" Foreground="#FF6B6A69" Margin="0,0,0,4" />
        <TextBox x:Name="TbA"
                 Padding="6"
                 FontSize="14"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MaxHeight="120"
                 VerticalScrollBarVisibility="Auto" />

        <TextBlock x:Name="LbB" FontSize="12" Foreground="#FF6B6A69" Margin="0,12,0,4" />
        <TextBox x:Name="TbB" Padding="6" FontSize="14" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
            <Button Content="确定" IsDefault="True" Padding="16,6" Click="BtnOk_Click" />
        </StackPanel>
    </StackPanel>
</Window>
