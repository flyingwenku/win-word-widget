<Window x:Class="Yiju.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一句 · 同步设置"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFF6F5F4"
        ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="WebDAV 地址" FontSize="12" Foreground="#FF6B6A69" Margin="0,0,0,4" />
        <TextBox x:Name="TbUrl" Padding="6" FontSize="13" />

        <TextBlock Text="账号（坚果云邮箱）" FontSize="12" Foreground="#FF6B6A69" Margin="0,12,0,4" />
        <TextBox x:Name="TbUser" Padding="6" FontSize="13" />

        <TextBlock Text="应用密码（不是登录密码）" FontSize="12" Foreground="#FF6B6A69" Margin="0,12,0,4" />
        <PasswordBox x:Name="TbPass" Padding="6" FontSize="13" />

        <TextBlock FontSize="11" Foreground="#FF8A8988" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="密码在坚果云网页端「账户信息 → 添加应用」里生成，存在本机时已用 Windows 账户加密。" />

        <CheckBox x:Name="CbAuto" Content="自动同步（内容改动后 10 秒，外加每 30 分钟兜底）"
                  Margin="0,12,0,0" FontSize="13" />

        <TextBlock x:Name="LbStatus" FontSize="12" Foreground="#FF6B6A69" Margin="0,12,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="立即同步" Padding="16,6" Margin="0,0,8,0" Click="BtnSync_Click" />
            <Button Content="关闭" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
            <Button Content="保存" IsDefault="True" Padding="16,6" Click="BtnSave_Click" />
        </StackPanel>
    </StackPanel>
</Window>
