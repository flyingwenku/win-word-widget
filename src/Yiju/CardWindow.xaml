<Window x:Class="Yiju.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一句"
        Width="380" Height="190"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="#FFB8B6B5"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!--
      卡片：没有标题栏、不在任务栏、不在 Alt+Tab。
      圆角靠 SetWindowRgn 切出来（不用 WS_EX_LAYERED —— 跨进程挂到壁纸层之后分层窗口不可靠）。
    -->
    <Grid>
        <Border x:Name="Card"
                Background="#FFB8B6B5"
                CornerRadius="14">
            <Grid Margin="18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TbSentence"
                           Grid.Row="0"
                           Text="学而时习之，不亦说乎？"
                           Foreground="#FF1F1F1E"
                           FontSize="20"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="TbSource"
                           Grid.Row="1"
                           Margin="0,10,24,0"
                           Text="《论语·学而》"
                           Foreground="#B31F1F1E"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- 右下角拖动缩放的把手 -->
        <Border x:Name="Grip"
                Width="14" Height="14"
                Margin="0,0,5,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#14000000"
                CornerRadius="2"
                Cursor="SizeNWSE" />
    </Grid>
</Window>
